import atletas.*
import elementos.*
import disciplinas.*

describe "Caso de prueba - Victoria"  {
    test "Victoria se quiere parecer a Pareto (que mide 150 cms), se hace pequeña, practica judo y por lo tanto necesita un judogi." {
        
        victoria.cambiarAltura(150)
        victoria.cambiarDisciplina(judo)
        victoria.cambiarElemento(judogi)

        assert.equals(150, victoria.altura())
        assert.equals(judo, victoria.disciplina())
        assert.equals( judogi, victoria.elemento())
    }
    test "Victoria ahora se quiere parecer a Delpo y empieza a practicar tenis. Elonga con intensidad hasta llegar a los dos metros diez, necesita una raqueta y tiene dos entrenadores." {
        victoria.cambiarDisciplina(tenis)
        victoria.cambiarAltura(210)
        victoria.cambiarElemento(raqueta)
        tenis.cambiarEntrenadores(2)

        assert.equals(tenis, victoria.disciplina())
        assert.equals(210, victoria.altura())
        assert.equals(raqueta, victoria.elemento())
        assert.equals(2, tenis.entrenadores())
    }

} 
